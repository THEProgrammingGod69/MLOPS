# Rendered at container start by prometheus-entrypoint.sh (Render deployment).
# Render's free tier has no private networking into web services, so Prometheus
# scrapes the API over its public HTTPS URL.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/alerts.yml"

scrape_configs:
  - job_name: "mlops-api"
    scheme: "__API_SCHEME__"
    metrics_path: /metrics
    scrape_timeout: 10s
    static_configs:
      - targets: ["__API_TARGET__"]
        labels:
          environment: "render"
