# Single public port: web UI + API at /, Grafana at /grafana/, Prometheus at /prometheus/.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
  access_log off;
  include /etc/nginx/mime.types;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  client_body_temp_path /tmp/nginx-body;
  proxy_temp_path /tmp/nginx-proxy;
  fastcgi_temp_path /tmp/nginx-fastcgi;
  uwsgi_temp_path /tmp/nginx-uwsgi;
  scgi_temp_path /tmp/nginx-scgi;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_read_timeout 120s;
  server {
    listen __PORT__;
    error_page 502 503 504 = @starting;
    location @starting {
      default_type text/html;
      add_header Cache-Control no-store always;
      return 503 '<!doctype html><meta charset=utf-8><meta http-equiv=refresh content=3><title>Starting</title><body style="background:#0b0f17;color:#cbd5e1;font:16px system-ui;display:grid;place-items:center;height:100vh;margin:0"><div>Service is waking up &hellip; this page refreshes automatically.</div>';
    }
    location = /grafana { return 302 /grafana/; }
    location /grafana/ {
      proxy_pass http://127.0.0.1:3300;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
    # Static UI straight from disk: no Python round-trip, so page loads never queue behind the API.
    location /ui/ {
      alias /app/frontend/dist/;
      index index.html;
      location /ui/assets/ { alias /app/frontend/dist/assets/; expires 7d; add_header Cache-Control "public, immutable"; }
    }
    location = /prometheus { return 302 /prometheus/; }
    # The bare Prometheus UI is an empty query box; open it on the key live series instead.
    location = /prometheus/ {
      return 302 '/prometheus/graph?g0.expr=sum(rate(student_dropout_predictions_total%5B1m%5D))&g0.tab=0&g0.range_input=15m&g1.expr=student_dropout_window_mean_risk&g1.tab=0&g1.range_input=15m&g2.expr=student_dropout_drifted_features&g2.tab=0&g2.range_input=15m&g3.expr=up&g3.tab=1';
    }
    location /prometheus/ { proxy_pass http://127.0.0.1:9090; }
    location / { proxy_pass http://127.0.0.1:8000; }
  }
}
